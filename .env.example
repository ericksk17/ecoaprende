# EcoAprende - Variables de entorno
# Copia este archivo como .env.local y llena los valores

# Base de datos PostgreSQL (obligatorio para Vercel)
# Formato: postgresql://usuario:password@host:5432/base_de_datos?sslmode=require
# Ejemplo Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ecoaprende"
